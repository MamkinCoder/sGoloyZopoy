# Copy to data/.env (gitignored). Loaded by `sgz` from $SGZ_DATA_DIR/.env.
SGZ_DATA_DIR=./data
SGZ_BIND=0.0.0.0:3002
SGZ_PANEL_PASSWORD=change-me
# Also used to link the web panel's queue page from Telegram run reports.
SGZ_PANEL_URL=http://sgz.rp.i
SGZ_SCHEDULE=12:00
# Chat bot: poll hh.ru chats every N minutes while no run is active (0 = off)
SGZ_CHAT_POLL_MIN=5
SGZ_TZ=Europe/Moscow
SGZ_RUNNER=true
SGZ_THROTTLE_MIN=8s
SGZ_THROTTLE_MAX=20s
TG_BOT_TOKEN=
TG_CHAT_ID=
CHROMIUM_BIN=/usr/bin/chromium
CLAUDE_BIN=claude
XELATEX_BIN=xelatex
