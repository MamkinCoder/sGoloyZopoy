# Copy to data/.env (gitignored). Loaded by `sgz` from $SGZ_DATA_DIR/.env.
SGZ_DATA_DIR=./data
SGZ_BIND=0.0.0.0:3002
SGZ_PANEL_PASSWORD=change-me
SGZ_PANEL_URL=http://sgz.rp.i
