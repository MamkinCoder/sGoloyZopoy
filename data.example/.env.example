SGZ_RUNNER=true
SGZ_THROTTLE_MIN=8s
SGZ_THROTTLE_MAX=20s
TG_BOT_TOKEN=
TG_CHAT_ID=
CHROMIUM_BIN=/usr/bin/chromium
CLAUDE_BIN=claude
XELATEX_BIN=xelatex
